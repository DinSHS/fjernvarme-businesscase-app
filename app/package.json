{
  "name": "fjernvarme-businesscase",
  "description": "Fjernvarme Businesscase — Fabric App (preview): dokumentation, metode, konfiguration af værker, analyser og scenarier for den åbne MILP-driftsmodel. Modellen kører i en Fabric Python-notebook; appen læser og skriver kun sin egen SQL-database.",
  "license": "MIT",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "predev": "rayfin env --framework vite",
    "prebuild": "rayfin env --framework vite",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:fabric": "tsc -b && vite build",
    "build:community": "tsc -b && vite build --mode community",
    "test:community": "node scripts/med-backend.mjs rest vitest run",
    "gate": "node scripts/gate.mjs",
    "tjek:deploy": "node scripts/tjek_deployede_assets.mjs",
    "deploy": "python ../scripts/installation.py rayfin-up",
    "deploy:tor": "python ../scripts/installation.py rayfin-up --tor",
    "db:apply": "python ../scripts/installation.py rayfin-db-apply",
    "installation:paafoer": "python ../scripts/installation.py paafoer",
    "installation:fjern": "python ../scripts/installation.py fjern",
    "tjek": "python ../scripts/tjek.py",
    "tokens": "node scripts/gen_tokens.mjs --tokens design/ibcs-tokens.json --overrides design/ibcs-tokens.overrides.json --out src/ibcs/tokens.generated.ts && node scripts/gen_tokens.mjs --tokens design/ibcs-tokens.json --out src/ibcs/tokens.base.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fabric": "node scripts/open-fabric-portal.mjs"
  },
  "dependencies": {
    "@microsoft/rayfin-auth-provider-fabric": "1.36.1",
    "@microsoft/rayfin-client": "1.36.1",
    "@microsoft/rayfin-core": "1.36.1",
    "@microsoft/rayfin-data": "1.36.1",
    "@microsoft/rayfin-lib": "1.36.1",
    "@tailwindcss/vite": "^4.3.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-error-boundary": "^6.1.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@microsoft/rayfin-cli": "1.36.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "rollup-plugin-license": "^3.7.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.38.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
